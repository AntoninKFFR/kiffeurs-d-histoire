{
  "name": "kiffeurs-histoire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && tsx --test scripts/import-descriptions.test.ts",
    "test:profil-browser": "tsx scripts/verifier-profil-local.ts",
    "test:bilan-browser": "tsx scripts/verifier-bilan-local.ts",
    "test:sous-packs-browser": "tsx scripts/verifier-sous-packs-local.ts",
    "test:e2e": "tsx e2e/preparer.ts && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:test-securite": "docker exec -i supabase_db_kiffeurs-histoire psql -U postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/reponses_invisibles.sql",
    "db:test-score": "docker exec -i supabase_db_kiffeurs-histoire psql -U postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/score.sql",
    "db:test-solo": "docker exec -i supabase_db_kiffeurs-histoire psql -U postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/solo.sql",
    "db:test-solo-retention": "docker exec -i supabase_db_kiffeurs-histoire psql -U postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/solo_anonymous_retention.sql",
    "db:test-inverse": "docker exec -i supabase_db_kiffeurs-histoire psql -U postgres -v ON_ERROR_STOP=1 -q -f - < supabase/tests/inverse.sql",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/import-dataset.ts",
    "content:audit-plages": "tsx scripts/verifier-plages-canoniques.ts",
    "content:test-cartes-local": "tsx scripts/test-cartes-local.ts",
    "content:relecture-cartes": "tsx scripts/generer-relecture-cartes.ts",
    "content:test-demo-pedagogie": "tsx scripts/verifier-demo-pedagogie.ts",
    "content:illustrations": "tsx --env-file-if-exists=.env.local scripts/upload-illustrations.ts",
    "content:catalogue-solo": "tsx scripts/build-catalogue-solo.ts",
    "content:structure-pedagogique": "tsx scripts/build-structure-pedagogique.ts",
    "test:sous-chapitres-sql": "tsx scripts/test-sous-chapitres-local.ts --container kffr-issue92-phase2",
    "test:sous-chapitres-http": "tsx scripts/test-import-sous-chapitres-http-local.ts --container kffr-issue92-phase2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
